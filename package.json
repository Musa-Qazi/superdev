{
  "name": "campus-devpulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host localhost",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test server/index.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^13.0.3",
    "@dnd-kit/core": "^6.3.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
